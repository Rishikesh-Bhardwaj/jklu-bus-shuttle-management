{
  "name": "jklu-shuttle-backend",
  "version": "1.0.0",
  "description": "Backend API for JKLU Bus Shuttle Management System",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.migrations.json",
    "start": "node dist-migrations/scripts/migrate.js && node dist/server.js",
    "db:verify": "tsx scripts/verify-db.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "setup:manager": "tsx scripts/setup-manager.ts",
    "test": "tsx scripts/test-suite.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
