# Server Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------------
# DATABASE IDENTITIES (THREE-TIER CREDENTIAL ARCHITECTURE)
# ------------------------------------------------------------------------------------
# Tier 1: 'root'
#   Reserved strictly for MySQL server administration, disaster recovery, and account provisioning.
#   Never used by application runtime or routine migration scripts.
#
# Tier 2: 'jklu_migration_admin' (DB_MIGRATION_USER)
#   Dedicated migration administrator account.
#   Granted DDL and schema management permissions exclusively on `jklu_bus_shuttle`.
#   Used by backend/scripts/migrate.ts and backend/scripts/verify-db.ts.
DB_MIGRATION_USER=jklu_migration_admin
DB_MIGRATION_PASSWORD=your_secure_migration_password

# Tier 3: 'jklu_app_user' (DB_USER)
#   Restricted application runtime account for the Express API server.
#   Granted least-privilege DML permissions exclusively (SELECT, INSERT, UPDATE, DELETE on operational tables).
#   On `user_verification_audit`: SELECT and INSERT ONLY (UPDATE, DELETE, TRUNCATE, and DDL prohibited).
#   Used by backend/src/config/db.ts.
DB_USER=jklu_app_user
DB_PASSWORD=your_secure_runtime_password

# Database Connection Target
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jklu_bus_shuttle

# Authentication & Session Security
JWT_SECRET=replace_with_a_secure_random_secret_in_production
JWT_EXPIRES_IN=7d
CSRF_SECRET=replace_with_a_secure_csrf_signing_secret_in_production
